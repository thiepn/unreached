{
  "name": "unreached",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "scripts": {
    "predev": "npm run geography:build",
    "dev": "vite",
    "build": "npm run typecheck && npm run data:check && npm run peoplegroups:check && npm run peoplegroups:runtime-check && npm run peoplegroups:visible-check && npm run geography:build && npm run geography:check && npm run visualization:check && npm run visualization:live-check && npm run country:check && npm run people:check && npm run context:check && npm run editorial-expansion:check && npm run prayer:check && npm run prayer-practice:check && npm run prayer-rotation:check && npm run prayer-session:check && npm run offline:check && npm run sync:check && npm run instant-data:check && npm run language:check && npm run discovery:check && npm run editorial-discovery:check && npm run release:check && vite build && npm run offline:dist && npm run release:dist",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "data:check": "tsx scripts/data/check.ts",
    "peoplegroups:check": "tsx scripts/data/peoplegroups/check.ts",
    "peoplegroups:runtime-check": "tsx scripts/data/peoplegroups/runtime-check.ts && tsx scripts/data/peoplegroups/cache-check.ts",
    "peoplegroups:visible-check": "tsx scripts/data/peoplegroups/visible-check.ts",
    "peoplegroups:editorial-identity-live-check": "tsx scripts/data/peoplegroups/editorial-identity-live-check.ts",
    "peoplegroups:live-corpus-check": "tsx scripts/data/peoplegroups/live-corpus-check.ts",
    "data:build:fixtures": "tsx scripts/data/build-fixtures.ts",
    "geography:build": "tsx scripts/geography/build-natural-earth.ts",
    "geography:check": "tsx scripts/geography/check.ts",
    "visualization:check": "tsx scripts/visualization/check.ts",
    "visualization:live-check": "tsx scripts/visualization/live-check.ts",
    "country:check": "tsx scripts/countries/check.ts",
    "people:check": "tsx scripts/peoples/check.ts",
    "context:check": "tsx scripts/context/check.ts",
    "editorial-expansion:check": "tsx scripts/context/v15-check.ts",
    "prayer:check": "tsx scripts/prayer/check.ts",
    "prayer-practice:check": "tsx scripts/prayer/v16-check.ts",
    "prayer-rotation:check": "tsx scripts/prayer/v17-check.ts",
    "prayer-session:check": "tsx scripts/prayer/v18-check.ts",
    "offline:check": "tsx scripts/offline/v19-check.ts",
    "offline:dist": "tsx scripts/offline/v19-dist-check.ts",
    "sync:check": "tsx scripts/sync/v20-check.ts",
    "instant-data:check": "tsx scripts/performance/v21-check.ts",
    "language:check": "tsx scripts/languages/check.ts",
    "discovery:check": "tsx scripts/discovery/check.ts",
    "editorial-discovery:check": "tsx scripts/discovery/v14-check.ts",
    "release:check": "tsx scripts/release/check.ts",
    "release:dist": "tsx scripts/release/check-dist.ts",
    "audit:baseline": "tsx scripts/audit/phase0-baseline.ts",
    "audit:phase0": "npm run audit:baseline && playwright test tests/e2e/phase0-regression.spec.ts tests/e2e/phase0-stress.spec.ts --project=chromium",
    "e2e": "playwright test",
    "preview": "vite preview",
    "check": "npm run build"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource-variable/source-sans-3": "5.3.0",
    "lucide-preact": "1.33.0",
    "maplibre-gl": "5.24.0",
    "preact": "10.29.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@preact/preset-vite": "2.10.6",
    "@types/geojson": "7946.0.16",
    "@types/node": "22.20.1",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}