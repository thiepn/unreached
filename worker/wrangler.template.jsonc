{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "unreached-private-continuity",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "unreached-private-continuity",
      "database_id": "__D1_DATABASE_ID__",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ACCESS_AUD": "__ACCESS_AUD__",
    "APP_ORIGIN": "https://www.thiepn.dev"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
